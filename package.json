{
    "name": "lumon",
    "version": "0.1.0",
    "private": true,
    "description": "Escritório simulado para agentes de inteligência artificial",
    "type": "module",
    "main": "dist-electron/principal.cjs",
    "scripts": {
        "postinstall": "bun x install-electron",
        "dev": "bun scripts/desenvolver.ts",
        "dev:web": "vite --host 127.0.0.1",
        "verificar": "tsc --noEmit",
        "build:desktop": "bun scripts/compilar.ts",
        "build": "bun run verificar && vite build && bun run build:desktop",
        "start": "electron ."
    },
    "trustedDependencies": [
        "electron",
        "esbuild"
    ],
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "^0.3.301",
        "@modelcontextprotocol/sdk": "^1.32.1",
        "@phosphor-icons/react": "^2.1.10",
        "@react-three/drei": "^10.7.9",
        "@react-three/fiber": "^9.8.2",
        "@react-three/postprocessing": "^3.2.0",
        "postprocessing": "^6.39.5",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-markdown": "^10.1.0",
        "remark-gfm": "^4.0.1",
        "three": "^0.186.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/bun": "^1.4.2",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.186.0",
        "@vitejs/plugin-react": "^6.1.2",
        "electron": "^44.7.0",
        "esbuild": "^0.28.2",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.4"
    }
}
